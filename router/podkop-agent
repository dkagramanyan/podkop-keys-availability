#!/bin/sh
# shellcheck shell=dash disable=SC1090,SC1091,SC2012,SC2016,SC2034,SC2317
#
# podkop-agent — runs on the OpenWrt router next to podkop and does what
# podkop-manager asks over SSH: read and change podkop's settings safely
# (check, write, restart, health check, undo), pin servers, run podkop-probe,
# stream events. "podkop-agent daemon" (procd) is a watchdog that keeps
# podkop running and puts pinned servers back after every restart.
#
# The manager's SSH key may run only this program (authorized_keys:
# restrict,command="/usr/bin/podkop-agent"); the command comes in
# $SSH_ORIGINAL_COMMAND, requests come as JSON on stdin, answers go as JSON to
# stdout: {"v":1,"ok":true,"data":...} or {"v":1,"ok":false,"error":{...}}.

AGENT_VERSION="0.5.0"
PROTO=1
ETC=/etc/podkop-agent
RUN=/tmp/podkop-agent
CFG=/etc/config/podkop
PODKOP_LIB=/usr/lib/podkop
PROBE=/usr/bin/podkop-probe
PROBE_CONF=/etc/podkop-probe.conf     # podkop-probe's own saved keys and settings
EVENTS=$RUN/events.ndjson
TAB=$(printf '\t')
BOOT=$(cut -c 1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo 00000000)

set -u
export LC_ALL=C
umask 077

# --- output -------------------------------------------------------------------

reply() { printf '{"v":%s,"ok":true,"data":%s}\n' "$PROTO" "${1:-null}"; exit 0; }

# fail <code> <message> [details json]
fail() {
  jq -nc --argjson v "$PROTO" --arg c "$1" --arg m "$2" --argjson d "${3:-null}" \
    '{v: $v, ok: false, error: {code: $c, message: $m, details: $d}}'
  exit 1
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# event <type> [json object with more fields]: append to the event log that
# "watch" streams; ids are "<boot>:<n>", so a reboot shows as a new boot
event() {
  mkdir -p "$RUN"
  _ef=${2:-}; [ -n "$_ef" ] || _ef='{}'
  (
    flock 8
    _n=$(( $(cat "$RUN/seq" 2>/dev/null || echo 0) + 1 ))
    echo "$_n" > "$RUN/seq"
    jq -nc --arg id "$BOOT:$_n" --arg t "$(now)" --arg ty "$1" --argjson f "$_ef" \
      '{id: $id, t: $t, type: $ty} + $f' >> "$EVENTS"
    if [ $((_n % 500)) = 0 ]; then   # keep the last 1000 events
      tail -n 1000 "$EVENTS" > "$EVENTS.t" && mv "$EVENTS.t" "$EVENTS"
    fi
  ) 8> "$RUN/events.lock"
}

# --- podkop's settings as JSON ----------------------------------------------------

# {"sections":[{"name","type","anonymous","options":{opt: "value" | ["list", ...]}}]}
# in podkop's order. Read through ubus, which gives lists as arrays.
UBUS2CONF='.values | [.[]] | sort_by(.[".index"])
  | {sections: map({name: .[".name"], type: .[".type"], anonymous: (.[".anonymous"] // false),
                    options: with_entries(select(.key | startswith(".") | not))})}'

# the same shape with every value a string (or array of strings)
NORM='{sections: [.sections[] | {name: (.name | tostring), type: (.type | tostring),
  anonymous: (.anonymous // false),
  options: ((.options // {}) | with_entries(.value |= (if type == "array" then map(tostring) else tostring end)))}]}'

# fingerprint of a config: podkop rewrites settings.shutdown_correctly on every
# start and stop, so it is left out
FP_JQ='(.sections[] | select(.name == "settings") | .options) |= del(.shutdown_correctly)'

# fails (no output) when ubus does not answer, e.g. while rpcd restarts
config_json() {
  _cj=$(ubus call uci get '{"config":"podkop"}' 2>/dev/null) && [ -n "$_cj" ] || return 1
  printf '%s' "$_cj" | jq -c "$UBUS2CONF"
}

# config_fp: the fingerprint of podkop's settings now; fails like config_json
config_fp() { _cf=$(config_json) && [ -n "$_cf" ] || return 1; printf '%s' "$_cf" | fingerprint; }
fingerprint() { jq -cS "$FP_JQ" | md5sum | cut -c 1-32; }

# the UCI file for a config
TOUCI=$(cat <<'EOF'
def q: "'" + (split("'") | join("'\\''")) + "'";
.sections[] | "",
  ("config " + .type + (if .anonymous then "" else " " + (.name | q) end)),
  (.options | to_entries[] | .key as $k
    | if (.value | type) == "array" then (.value[] | "\tlist " + $k + " " + q)
      else "\toption " + $k + " " + (.value | q) end)
EOF
)

# --- checks before podkop is touched ----------------------------------------------

# podkop refuses to start (exit 1, proxy and DNS down) on all of these
CHECK_JQ=$(cat <<'EOF'
def err($s; $o; $m): {section: $s, option: $o, message: $m};
def lst: if . == null then [] elif type == "array" then . else [.] end;
($svc | split(" ") | map(select(. != ""))) as $services
| [ (if ([.sections[] | select(.name == "settings" and .type == "settings")] | length) != 1
      then err("settings"; null; "there must be one section of type settings named settings") else empty end),
    (.sections | group_by(.name)[] | select(length > 1) | err(.[0].name; null; "this name is used by two sections")),
    (.sections[] | select(.name == "settings") | .options
      | if ((.dns_type // "udp") | IN("udp", "dot", "doh")) then empty
        else err("settings"; "dns_type"; "must be udp, dot or doh") end),
    (.sections[] | select(.type == "section") | .name as $s | .options as $o
      | ($o.connection_type // "") as $ct
      | (if ($ct | IN("proxy", "vpn", "block", "exclusion") | not)
           then err($s; "connection_type"; "must be proxy, vpn, block or exclusion")
         elif $ct == "proxy" then
           ($o.proxy_config_type // "") as $pt
           | if ($pt | IN("url", "selector", "urltest", "outbound") | not)
               then err($s; "proxy_config_type"; "must be url, selector, urltest or outbound")
             elif $pt == "url" and ($o.proxy_string // "") == "" then err($s; "proxy_string"; "is empty")
             elif $pt == "selector" and ($o.selector_proxy_links | lst | length) == 0
               then err($s; "selector_proxy_links"; "needs at least one link")
             elif $pt == "urltest" and ($o.urltest_proxy_links | lst | length) == 0
               then err($s; "urltest_proxy_links"; "needs at least one link")
             elif $pt == "outbound" and ((($o.outbound_json // "") | try fromjson catch null) | type) != "object"
               then err($s; "outbound_json"; "is not a JSON object")
             else empty end
         elif $ct == "vpn" and ($o.interface // "") == "" then err($s; "interface"; "is empty")
         else empty end),
        ($o.community_lists | lst | .[] | select(IN($services[]) | not)
          | err($s; "community_lists"; "podkop has no list \"\(.)\"")),
        (if ($o.mixed_proxy_enabled // "0") == "1" and ((($o.mixed_proxy_port // "") | tonumber?) // null) == null
           then err($s; "mixed_proxy_port"; "must be a port number") else empty end),
        (if ($o.urltest_tolerance // "") != "" and ((($o.urltest_tolerance | tonumber?) // null) == null)
           then err($s; "urltest_tolerance"; "must be a number") else empty end))
  ]
EOF
)

# the links podkop will parse: section, option, index, link (tab separated)
LINKS_JQ=$(cat <<'EOF'
def lst: if . == null then [] elif type == "array" then . else [.] end;
.sections[] | select(.type == "section" and .options.connection_type == "proxy")
| .name as $s | .options as $o
| (if $o.proxy_config_type == "url" then [[$s, "proxy_string", 0, $o.proxy_string]]
   elif $o.proxy_config_type == "selector" then [$o.selector_proxy_links | lst | to_entries[] | [$s, "selector_proxy_links", .key, .value]]
   elif $o.proxy_config_type == "urltest" then
     [($o.urltest_proxy_links | lst | to_entries[] | [$s, "urltest_proxy_links", .key, .value]),
      ($o.urltest_fallback_links | lst | to_entries[] | [$s, "urltest_fallback_links", .key, .value])]
   else [] end)[] | @tsv
EOF
)

# check_links < tsv: each link through podkop's own parser -> error objects
check_links() (
  set +u
  . "$PODKOP_LIB/sing_box_config_facade.sh"
  log() { case "$2" in error|fatal) printf '%s\n' "$1" >> "$RUN/chk.$$.err" ;; esac; }
  while IFS="$TAB" read -r _s _o _i _l; do
    rm -f "$RUN/chk.$$.err"
    ( sing_box_cf_add_proxy_outbound '{"outbounds":[]}' chk "$_l" 0 ) > "$RUN/chk.$$.out" 2>/dev/null
    if [ -s "$RUN/chk.$$.err" ] || ! jq -e '.outbounds[0]' "$RUN/chk.$$.out" >/dev/null 2>&1; then
      jq -nc --arg s "$_s" --arg o "$_o" --argjson i "$_i" \
        --arg m "$(head -n 1 "$RUN/chk.$$.err" 2>/dev/null | sed 's/ Aborted\.$//')" \
        '{section: $s, option: $o, index: $i, message: (if $m == "" then "podkop cannot read this link" else $m end)}'
    fi
  done
  rm -f "$RUN/chk.$$.err" "$RUN/chk.$$.out"
)

# check_outbounds <config file>: outbound_json of each section through sing-box check
check_outbounds() {
  jq -r '.sections[] | select(.type == "section" and .options.connection_type == "proxy"
           and .options.proxy_config_type == "outbound") | .name' "$1" |
  while IFS= read -r _s; do
    jq -c --arg s "$_s" '{log: {disabled: true},
        outbounds: [.sections[] | select(.name == $s) | .options.outbound_json | fromjson | .tag = "x"]}' \
      "$1" > "$RUN/chk.$$.json"
    if ! _m=$(sing-box check -c "$RUN/chk.$$.json" 2>&1); then
      jq -nc --arg s "$_s" --arg m "$(printf '%s' "$_m" | tail -n 1)" \
        '{section: $s, option: "outbound_json", message: ("sing-box: " + $m)}'
    fi
  done
  rm -f "$RUN/chk.$$.json"
}

community_lists() ( set +u; . "$PODKOP_LIB/constants.sh" 2>/dev/null; printf '%s' "${COMMUNITY_SERVICES:-}" )

# validate <config file> -> JSON array of problems ([] = fine)
validate() {
  _svc=$(community_lists)
  {
    jq -c --arg svc "$_svc" "$CHECK_JQ | .[]" "$1"
    jq -r "$LINKS_JQ" "$1" | check_links
    check_outbounds "$1"
  } | jq -sc '.'
}

# names that go into the UCI file unquoted must be plain words
check_names() {
  jq -r '.sections[] | .type, (if .anonymous then empty else .name end), (.options | keys_unsorted[])' "$1" |
  while IFS= read -r _w; do
    case "$_w" in ""|*[!A-Za-z0-9_]*) printf '%s\n' "$_w"; return ;; esac
  done
}

# --- podkop's state ------------------------------------------------------------

# podkop_start_state: running (its start is still going), none, or the exit code
podkop_start_state() {
  ubus call service list '{"name":"podkop"}' 2>/dev/null | jq -r '[.podkop.instances[]?]
    | if length == 0 then "none" elif any(.running) then "running"
      else (map(.exit_code // 0) | max | tostring) end'
}

# the engine's failsafe writes why it stopped podkop; only a fresh note matters
failsafe_recent() {
  find /etc/sing-box/failsafe.last -mmin -10 2>/dev/null | grep -q . && tail -n 1 /etc/sing-box/failsafe.last
}

podkop_enabled() { /etc/init.d/podkop enabled 2>/dev/null; }
singbox_pid() { pidof sing-box 2>/dev/null | cut -d ' ' -f 1; }
proxies() { podkop clash_api get_proxies 2>/dev/null; }

# fatal_since <marker>: podkop's first fatal message after our marker log line
fatal_since() {
  logread 2>/dev/null | sed -n "/podkop-agent: $1\$/,\$p" | grep '\[fatal\]' | head -n 1 |
    sed 's/.*\[fatal\] //; s/ Aborted\.$//'
}

dns_ok() {
  for _h in openwrt.org ya.ru; do
    nslookup "$_h" 127.0.0.1 2>/dev/null |
      awk '/^Name:/ { n = 1; next } n && /^Address/ { f = 1 } END { exit !f }' && return 0
  done
  return 1
}

# health <marker>: after a restart, wait until podkop runs every section's
# outbound and DNS answers; on failure the reason goes to stdout
health() {
  _w=0
  while :; do
    _st=$(podkop_start_state)
    case "$_st" in
      running|none) ;;
      0) break ;;
      *) _m=$(fatal_since "$1"); echo "podkop did not start${_m:+: $_m}"; return 1 ;;
    esac
    [ "$_w" -ge 90 ] && { echo "podkop start did not finish in 90 s"; return 1; }
    sleep 2; _w=$((_w + 2))
  done
  _tags=$(config_json | jq -r '.sections[] | select(.type == "section"
            and (.options.connection_type | IN("proxy", "vpn"))) | .name + "-out"')
  _w=0
  while :; do
    _p=$(proxies)
    _miss=""
    for _t in $_tags; do
      printf '%s' "$_p" | jq -e --arg t "$_t" '.proxies[$t]' >/dev/null 2>&1 || _miss="$_miss $_t"
    done
    [ -n "$_p" ] && [ -z "$_miss" ] && break
    case "$(podkop_start_state)" in
      running|none|0) ;;
      *) _m=$(fatal_since "$1"); echo "podkop did not start${_m:+: $_m}"; return 1 ;;
    esac
    if [ "$_w" -ge 30 ]; then
      if [ -z "$(singbox_pid)" ]; then echo "sing-box is not running"; else echo "sing-box has no outbound${_miss}"; fi
      return 1
    fi
    sleep 2; _w=$((_w + 2))
  done
  _w=0
  until dns_ok; do
    [ "$_w" -ge 20 ] && { echo "DNS through the router does not answer"; return 1; }
    sleep 2; _w=$((_w + 2))
  done
  return 0
}

# restart_podkop <marker>
restart_podkop() {
  logger -t podkop-agent "$1"
  # 9>&-: podkop must not inherit (and keep holding) the apply lock
  /etc/init.d/podkop restart >/dev/null 2>&1 9>&-
}

# --- only servers changed: no podkop restart -----------------------------------

# A full restart stops sing-box, removes the firewall rules and DNS setup,
# rebuilds everything and loads the IP lists again: 20-30 s without proxy.
# When only the servers of rules changed, nothing but sing-box's config
# depends on that: podkop's own functions build its new config, and
# sing-box reloads it in place (SIGHUP), a fraction of a second.

# the options that only say which servers a rule uses
SERVER_OPTS='["urltest_proxy_links","urltest_fallback_links","selector_proxy_links","proxy_string"]'

# servers_only <old config> <new config> (JSON files): they differ only in those
servers_only() {
  jq -n --slurpfile a "$1" --slurpfile b "$2" --argjson o "$SERVER_OPTS" '
    def strip: ((.sections[] | select(.name == "settings") | .options) |= del(.shutdown_correctly))
      | .sections |= map(.options |= with_entries(select(.key | IN($o[]) | not)));
    ($a[0] | strip) == ($b[0] | strip)' 2>/dev/null | grep -qx true
}

# podkop_build <file>: the sing-box config podkop makes from its settings now,
# by its own functions (its start runs the same sing_box_init_config, which
# only builds JSON); only the last step, saving it, writes to <file> instead
podkop_build() (
  set +u
  _out=$1
  for _f in /lib/functions.sh /lib/config/uci.sh /lib/functions/network.sh; do . "$_f" || exit 1; done
  for _f in constants nft helpers sing_box_config_manager sing_box_config_facade logging rulesets; do
    . "$PODKOP_LIB/$_f.sh" || exit 1
  done
  # podkop's functions, without running podkop (outside them it only loads
  # these files and runs the command it is given)
  eval "$(sed -n '/^[A-Za-z_][A-Za-z0-9_]*() {$/,/^}$/p' /usr/bin/podkop)" || exit 1
  # shellcheck disable=SC2329   # called by podkop's functions
  log() { case "${2:-}" in error|fatal) printf '%s\n' "$1" >> "$_out.err" ;; esac; }
  # a start finds the rule-set folder empty (its stop empties it), so each
  # local rule set is added as new; here its file is already there, with the
  # same content (podkop merges the same, unchanged lists into it again)
  # shellcheck disable=SC2329
  create_source_rule_set() { [ -f "$1" ] || jq -n '{version: 3, rules: []}' > "$1"; }
  # $config: podkop's sing_box_init_config builds it
  # shellcheck disable=SC2154,SC2329
  sing_box_save_config() { sing_box_cm_save_config_to_file "$config" "$_out" && sing-box check -c "$_out" >/dev/null 2>&1; }
  config_load podkop
  sing_box_init_config
)

# hot_apply <marker>: podkop runs; its new sing-box config goes in and
# sing-box reloads it; fails (and the caller restarts podkop) when anything
# is off. On failure the reason goes to stdout.
hot_apply() {
  _hp=$(singbox_pid)
  if [ -z "$_hp" ] || [ "$(podkop_start_state)" != 0 ]; then echo "podkop is not fully running"; return 1; fi
  _cp=$(uci -q get podkop.settings.config_path)
  if [ -z "$_cp" ] || [ ! -f "$_cp" ]; then echo "no sing-box config file"; return 1; fi
  _hb="$RUN/hot.$$.json"
  rm -f "$_hb" "$_hb.err"
  if ! podkop_build "$_hb" || [ -s "$_hb.err" ] || ! jq -e '.outbounds' "$_hb" >/dev/null 2>&1; then
    echo "podkop could not build the config: $(head -n 1 "$_hb.err" 2>/dev/null)"; rm -f "$_hb" "$_hb.err"; return 1
  fi
  logger -t podkop-agent "$1"
  if ! cmp -s "$_hb" "$_cp"; then
    if ! { cp "$_hb" "$_cp.agent-new" && mv "$_cp.agent-new" "$_cp"; }; then
      rm -f "$_hb" "$_cp.agent-new"; echo "could not write $_cp"; return 1
    fi
  fi
  _tags=$(jq -r '.outbounds[].tag' "$_hb")
  rm -f "$_hb" "$_hb.err"
  kill -HUP "$_hp" 2>/dev/null || { echo "sing-box did not take the signal"; return 1; }
  # the same sing-box, with every outbound of the new config
  _w=0
  while :; do
    sleep 1; _w=$((_w + 1))
    [ "$(singbox_pid)" = "$_hp" ] || { echo "sing-box stopped while reloading"; return 1; }
    _p=$(proxies); _miss=""
    for _t in $_tags; do
      case "$_t" in direct-out|*-urltest-out) continue ;; esac
      printf '%s' "$_p" | jq -e --arg t "$_t" '.proxies[$t]' >/dev/null 2>&1 || _miss="$_miss $_t"
    done
    [ -n "$_p" ] && [ -z "$_miss" ] && break
    [ "$_w" -ge 15 ] && { echo "sing-box did not take the new servers:${_miss:- no Clash API}"; return 1; }
  done
  dns_ok || { sleep 2; dns_ok; } || { echo "DNS through the router does not answer"; return 1; }
}

# through temp files, so a full disk can't leave a cut-off copy
save_last_good() {
  cp "$CFG" "$ETC/last-good.t" && mv "$ETC/last-good.t" "$ETC/last-good" &&
    config_fp > "$ETC/last-good.fp.t" && mv "$ETC/last-good.fp.t" "$ETC/last-good.fp"
}

backup_config() {
  mkdir -p "$ETC/backups"
  _b="$ETC/backups/podkop.$(date +%Y%m%d-%H%M%S)"
  cp "$CFG" "$_b" || return 1
  ls -1t "$ETC/backups"/podkop.* 2>/dev/null | tail -n +11 | while IFS= read -r _f; do rm -f "$_f"; done
  echo "$_b"
}

# install_config <file>: replace podkop's settings in one rename
install_config() { cp "$1" "$CFG.agent-new" && mv "$CFG.agent-new" "$CFG"; }

# --- pinned servers ---------------------------------------------------------------

# pins file: "<section><TAB><md5 of the link>"; the tag of a link is its position
# in the section, so after a change the pin follows the link, not the position
link_md5() { printf '%s' "$1" | md5sum | cut -c 1-32; }

# tag_link <section> <tag> -> the link behind an outbound tag of the section
tag_link() {
  config_json | jq -r --arg s "$1" --arg t "$2" '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    .sections[] | select(.name == $s) | .options as $o
    | (if $o.proxy_config_type == "urltest" then
         [($o.urltest_proxy_links | lst | to_entries[] | {t: "\($s)-\(.key + 1)-out", l: .value}),
          ($o.urltest_fallback_links | lst | to_entries[] | {t: "\($s)-fallback-\(.key + 1)-out", l: .value})]
       elif $o.proxy_config_type == "selector" then
         [$o.selector_proxy_links | lst | to_entries[] | {t: "\($s)-\(.key + 1)-out", l: .value}]
       else [] end)[] | select(.t == $t) | .l' | head -n 1
}

# link_tag <section> <md5> -> the current tag of that link
link_tag() {
  config_json | jq -r --arg s "$1" '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    .sections[] | select(.name == $s) | .options as $o
    | if $o.proxy_config_type == "urltest" then
        ($o.urltest_proxy_links | lst | to_entries[] | "\($s)-\(.key + 1)-out\t\(.value)"),
        ($o.urltest_fallback_links | lst | to_entries[] | "\($s)-fallback-\(.key + 1)-out\t\(.value)")
      elif $o.proxy_config_type == "selector" then
        ($o.selector_proxy_links | lst | to_entries[] | "\($s)-\(.key + 1)-out\t\(.value)")
      else empty end' |
  while IFS="$TAB" read -r _t _l; do
    [ "$(link_md5 "$_l")" = "$2" ] && { echo "$_t"; return; }
  done
}

select_server() { podkop clash_api set_group_proxy "$1-out" "$2" 2>/dev/null | jq -e '.success' >/dev/null 2>&1; }

# reapply_pins: after a restart podkop's selectors start on their default
# fails when a pinned server could not be selected (Clash API not up yet)
reapply_pins() {
  [ -s "$ETC/pins" ] || return 0
  mkdir -p "$RUN"
  exec 6> "$RUN/pins.lock"; flock 6
  : > "$RUN/pins.new"; _rp=0
  while IFS="$TAB" read -r _s _h; do
    _t=$(link_tag "$_s" "$_h")
    if [ -z "$_t" ]; then
      event pin_dropped "$(jq -nc --arg s "$_s" '{section: $s, reason: "the pinned server is no longer in the section"}')"
      continue
    fi
    printf '%s\t%s\n' "$_s" "$_h" >> "$RUN/pins.new"
    if select_server "$_s" "$_t"; then
      event pin_restored "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
    else
      _rp=1
    fi
  done < "$ETC/pins"
  # /etc is flash: written only when a pin was dropped
  if cmp -s "$RUN/pins.new" "$ETC/pins"; then rm -f "$RUN/pins.new"
  else cp "$RUN/pins.new" "$ETC/pins.t" && mv "$ETC/pins.t" "$ETC/pins"; rm -f "$RUN/pins.new"; fi
  exec 6>&-
  return "$_rp"
}

# --- jobs (changes run detached, so a dropped SSH connection can't cut them) -------

job_file() { echo "$RUN/jobs/$1.json"; }

# job_set <id> <jq filter> [jq args ...]
job_set() {
  _jf=$(job_file "$1"); _flt=$2; shift 2
  jq -c "$@" "$_flt" "$_jf" > "$_jf.t" && mv "$_jf.t" "$_jf"
}

job_new() { # <kind> -> id
  mkdir -p "$RUN/jobs"
  _id="$(date +%Y%m%d%H%M%S)-$$"
  jq -nc --arg id "$_id" --arg k "$1" --arg t "$(now)" '{id: $id, kind: $k, state: "queued", started: $t}' > "$(job_file "$_id")"
  ls -1t "$RUN/jobs"/*.json 2>/dev/null | tail -n +21 | while IFS= read -r _f; do rm -f "$_f" "${_f%.json}".*; done
  echo "$_id"
}

# job_end <id> <state> <message> [fields json]
job_end() {
  _ex=${4:-}; [ -n "$_ex" ] || _ex='{}'
  job_set "$1" '. + {state: $s, message: $m, finished: $t} + $x' --arg s "$2" --arg m "$3" --arg t "$(now)" --argjson x "$_ex"
}

spawn() { env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT setsid "$0" "$@" </dev/null >/dev/null 2>&1 & }

# the apply transaction; input in jobs/<id>.in: {"base": fingerprint, "config": {...}}
run_apply() {
  _id=$1; _in="$RUN/jobs/$_id.in"; _new="$RUN/jobs/$_id.conf"
  exec 9> "$RUN/apply.lock"; flock 9
  job_set "$_id" '.state = "checking"'
  jq -c ".config | $NORM" "$_in" > "$_new" 2>/dev/null || { job_end "$_id" rejected "the config is not valid JSON"; return; }
  _cur=$(config_fp) || { job_end "$_id" failed "could not read podkop's settings (ubus does not answer)"; return; }
  _base=$(jq -r '.base // ""' "$_in")
  if [ -n "$_base" ] && [ "$_base" != "$_cur" ]; then
    job_end "$_id" rejected "podkop's settings changed since you loaded them; reload and apply again" \
      "$(jq -nc --arg c "$_cur" '{code: "config_changed", fingerprint: $c}')"
    return
  fi
  _bad=$(check_names "$_new")
  [ -z "$_bad" ] || { job_end "$_id" rejected "\"$_bad\" is not a valid name"; return; }
  _probs=$(validate "$_new")
  if [ "$_probs" != "[]" ]; then
    job_end "$_id" rejected "podkop would not start with these settings" "$(jq -nc --argjson p "$_probs" '{problems: $p}')"
    return
  fi
  _nfp=$(fingerprint < "$_new")
  if [ "$_nfp" = "$_cur" ]; then job_end "$_id" unchanged "nothing to change"; return; fi
  config_json > "$RUN/jobs/$_id.old" || { job_end "$_id" failed "could not read podkop's settings (ubus does not answer)"; return; }
  mkdir -p "$RUN/stage"
  jq -r "$TOUCI" "$_new" > "$RUN/stage/podkop"
  uci -c "$RUN/stage" -q show podkop >/dev/null 2>&1 || { job_end "$_id" rejected "could not write the settings file"; return; }
  _bak=$(backup_config) || { job_end "$_id" failed "could not back up $CFG"; return; }
  # survives a reboot: the daemon puts the backup back if this apply never ends
  printf '%s\t%s\n' "$_id" "$_bak" > "$ETC/apply-pending" || { job_end "$_id" failed "could not write $ETC/apply-pending"; return; }
  install_config "$RUN/stage/podkop" || { rm -f "$ETC/apply-pending"; job_end "$_id" failed "could not write $CFG"; return; }
  _x=$(jq -nc --arg b "$_cur" --arg a "$_nfp" --arg k "$_bak" '{fingerprint_before: $b, fingerprint_after: $a, backup: $k}')
  if [ -f "$ETC/paused" ] || ! podkop_enabled; then
    rm -f "$ETC/apply-pending"
    job_end "$_id" saved "saved; podkop is stopped, so it was not restarted" "$_x"
    event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: false}')"
    return
  fi
  # only servers changed: sing-box takes them without a podkop restart
  if servers_only "$RUN/jobs/$_id.old" "$_new"; then
    job_set "$_id" '.state = "reloading"'
    if _hw=$(hot_apply "apply $_id (servers only)"); then
      save_last_good; rm -f "$ETC/apply-pending"; reapply_pins
      job_end "$_id" applied "applied without restarting podkop (only servers changed)" "$(printf '%s' "$_x" | jq -c '. + {hot: true}')"
      event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: true, hot: true}')"
      return
    fi
    logger -t podkop-agent "apply $_id: no reload in place ($_hw), restarting podkop"
  fi
  job_set "$_id" '.state = "restarting"'
  restart_podkop "apply $_id"
  if _why=$(health "apply $_id"); then
    save_last_good; rm -f "$ETC/apply-pending"; reapply_pins
    job_end "$_id" applied "applied, podkop is running" "$_x"
    event applied "$(jq -nc --arg j "$_id" '{job: $j, restarted: true}')"
    return
  fi
  job_set "$_id" '.state = "reverting"'
  if ! install_config "$_bak"; then
    rm -f "$ETC/apply-pending"
    job_end "$_id" failed "$_why; the old settings could not be restored (could not write $CFG from $_bak)" "$_x"
    event revert_failed "$(jq -nc --arg j "$_id" --arg r "$_why" --arg r2 "could not write $CFG from $_bak" '{job: $j, reason: $r, revert_reason: $r2}')"
    return
  fi
  restart_podkop "revert $_id"
  if _why2=$(health "revert $_id"); then
    reapply_pins
    job_end "$_id" reverted "$_why; the old settings are back" "$(printf '%s' "$_x" | jq -c --arg r "$_why" '. + {reason: $r}')"
    event reverted "$(jq -nc --arg j "$_id" --arg r "$_why" '{job: $j, reason: $r}')"
  else
    job_end "$_id" failed "$_why; the old settings are back, but podkop does not run with them either: $_why2" "$_x"
    event revert_failed "$(jq -nc --arg j "$_id" --arg r "$_why" --arg r2 "$_why2" '{job: $j, reason: $r, revert_reason: $r2}')"
  fi
  rm -f "$ETC/apply-pending"
}

# undo_interrupted: an apply cut off by a reboot or a kill left
# $ETC/apply-pending ("<job><TAB><backup>"); put the backup back
undo_interrupted() {
  [ -s "$ETC/apply-pending" ] || return 0
  exec 9> "$RUN/apply.lock"
  flock -n 9 || { exec 9>&-; return 0; }   # that apply is still running
  IFS="$TAB" read -r _id _bak < "$ETC/apply-pending"
  if [ -f "$_bak" ] && install_config "$_bak"; then
    _st=reverted; _m="the apply was interrupted (reboot or killed); the old settings were put back"
    [ -f "$ETC/paused" ] || ! podkop_enabled || restart_podkop "undo interrupted apply $_id"
  else
    _st=failed; _m="the apply was interrupted (reboot or killed); the old settings could not be put back from $_bak"
  fi
  rm -f "$ETC/apply-pending"
  if [ -f "$(job_file "$_id")" ]; then
    case "$(jq -r .state "$(job_file "$_id")" 2>/dev/null)" in
      queued|checking|restarting|reverting) job_end "$_id" "$_st" "$_m" ;;
    esac
  fi
  event apply_interrupted "$(jq -nc --arg j "$_id" --arg b "$_bak" --arg m "$_m" '{job: $j, backup: $b, message: $m}')"
  exec 9>&-
}

# --- watchdog -------------------------------------------------------------------

# recover: podkop is enabled but sing-box is gone (failsafe, crash, reboot);
# at most 3 tries an hour, so it can't fight a crash loop
recover() {
  _t=$(date +%s)
  awk -v t="$_t" '$1 > t - 3600' "$RUN/recoveries" 2>/dev/null > "$RUN/recoveries.t"
  mv "$RUN/recoveries.t" "$RUN/recoveries"
  if [ "$(wc -l < "$RUN/recoveries")" -ge 3 ]; then
    [ -f "$RUN/gave-up" ] || { touch "$RUN/gave-up"; event recovery_gave_up '{"reason":"3 recoveries in the last hour"}'; }
    return
  fi
  echo "$_t" >> "$RUN/recoveries"
  exec 9> "$RUN/apply.lock"; flock 9
  # first with the settings as they are (LuCI or the probe may have changed
  # them on purpose); the last settings applied here only if that fails
  _what="restarted podkop"
  restart_podkop "recover $_t"
  if ! _why=$(health "recover $_t") && [ -s "$ETC/last-good" ] && _fp=$(config_fp) &&
     [ "$_fp" != "$(cat "$ETC/last-good.fp" 2>/dev/null)" ] &&
     backup_config >/dev/null && install_config "$ETC/last-good"; then
    _what="podkop did not start with its settings ($_why); restored the last working settings and restarted podkop"
    restart_podkop "recover $_t last-good"
    _why=$(health "recover $_t last-good") && _why=""
  fi
  if [ -z "$_why" ]; then
    rm -f "$RUN/gave-up"; reapply_pins
    event recovered "$(jq -nc --arg w "$_what" '{action: $w}')"
  else
    event recovery_failed "$(jq -nc --arg w "$_what" --arg r "$_why" '{action: $w, reason: $r}')"
  fi
  exec 9>&-
}

# --- traffic per server ------------------------------------------------------------

# traffic_poll: add each connection's new bytes to its server (the first
# outbound of its chain, e.g. main-2-out). Bytes of connections that ended
# between two polls are shared out like the seen ones. Kept since the agent
# started in $RUN/traffic/state.json; "links" also keeps them per
# "<section><TAB><link>", the link behind each tag at the time of the poll, so
# a reorder of the links doesn't move bytes to another server.
traffic_poll() {
  _cfg=$(uci -q get podkop.settings.config_path); [ -n "$_cfg" ] || _cfg=/etc/sing-box/config.json
  _addr=$(jq -r '.experimental.clash_api.external_controller // empty' "$_cfg" 2>/dev/null)
  _sec=$(jq -r '.experimental.clash_api.secret // empty' "$_cfg" 2>/dev/null)
  [ -n "$_addr" ] || return 0
  if [ -n "$_sec" ]; then _c=$(curl -s --max-time 5 -H "Authorization: Bearer $_sec" "http://$_addr/connections")
  else _c=$(curl -s --max-time 5 "http://$_addr/connections"); fi
  [ -n "$_c" ] || return 0
  # tag -> "<section><TAB><link>", named like tag_link does (and "<section>-out" for a url section)
  _tl=$(ubus call uci get '{"config":"podkop"}' 2>/dev/null | jq -c '
    def lst: if . == null then [] elif type == "array" then . else [.] end;
    '"$UBUS2CONF"' | [.sections[] | select(.options.connection_type == "proxy") | .name as $s | .options as $o
    | if $o.proxy_config_type == "urltest" then
        ($o.urltest_proxy_links | lst | to_entries[] | {key: "\($s)-\(.key + 1)-out", value: "\($s)\t\(.value)"}),
        ($o.urltest_fallback_links | lst | to_entries[] | {key: "\($s)-fallback-\(.key + 1)-out", value: "\($s)\t\(.value)"})
      elif $o.proxy_config_type == "selector" then
        ($o.selector_proxy_links | lst | to_entries[] | {key: "\($s)-\(.key + 1)-out", value: "\($s)\t\(.value)"})
      elif $o.proxy_config_type == "url" and ($o.proxy_string // "") != "" then
        {key: "\($s)-out", value: "\($s)\t\($o.proxy_string)"}
      else empty end] | from_entries')
  [ -n "$_tl" ] || _tl='{}'
  _d="$RUN/traffic"; mkdir -p "$_d"
  # a missing, empty or broken state starts over
  jq -e .servers "$_d/state.json" >/dev/null 2>&1 || jq -nc --arg t "$(now)" '{since: $t, total: 0, conns: {}, servers: {}, links: {}}' > "$_d/state.json"
  printf '%s' "$_c" | jq -c --slurpfile st "$_d/state.json" --argjson tl "$_tl" '
    $st[0] as $s
    | [.connections[]? | {id, b: ((.upload // 0) + (.download // 0)), tag: ((.chains // [])[0] // "")}] as $cs
    | ((.uploadTotal // 0) + (.downloadTotal // 0)) as $total
    | [$cs[] | {tag, d: ([.b - ($s.conns[.id] // 0), 0] | max)}] as $ds
    | ([$ds[].d] | add // 0) as $seen
    | ([(if $total >= $s.total then $total - $s.total else $total end) - $seen, 0] | max) as $gone
    | [$ds[] | {tag, n: (.d + (if $seen > 0 then $gone * .d / $seen else 0 end) | floor)}] as $ns
    | {since: $s.since, total: $total, conns: ($cs | map({key: .id, value: .b}) | from_entries),
       servers: (reduce $ns[] as $x ($s.servers; .[$x.tag] += $x.n)
                 | if $seen == 0 and $gone > 0 then .[""] += $gone else . end),
       # only the links podkop has now: the file in RAM does not grow as links come and go
       links: (reduce $ns[] as $x ($s.links // {}; if $tl[$x.tag] then .[$tl[$x.tag]] += $x.n else . end)
               | ([$tl[]] | map({key: ., value: true}) | from_entries) as $live
               | with_entries(select($live[.key])))}' > "$_d/state.new" 2>/dev/null &&
    mv "$_d/state.new" "$_d/state.json"
}

daemon() {
  mkdir -p "$RUN/jobs" "$ETC"
  event agent_started "$(jq -nc --arg v "$AGENT_VERSION" '{version: $v}')"
  undo_interrupted
  _last=""; _down=0
  while :; do
    sleep 15
    [ -n "$(singbox_pid)" ] && traffic_poll
    if [ -f "$ETC/paused" ] || ! podkop_enabled; then _down=0; continue; fi
    # a change or a recovery holds the lock; podkop's own start takes a while
    flock -n "$RUN/apply.lock" true || continue
    # an apply killed while the daemon runs (e.g. out of memory)
    [ -s "$ETC/apply-pending" ] && { undo_interrupted; continue; }
    [ "$(podkop_start_state)" = running ] && continue
    _pid=$(singbox_pid)
    if [ -n "$_pid" ]; then
      [ "$_down" -ge 2 ] && event podkop_up
      _down=0
      # tried every round until the Clash API answers and the pins are back
      if [ "$_pid" != "$_last" ] && [ -n "$(proxies)" ] && reapply_pins; then
        _last=$_pid
      fi
      continue
    fi
    # podkop's own start at boot can wait for the network for a while
    [ "$(cut -d . -f 1 /proc/uptime)" -lt 180 ] && continue
    _down=$((_down + 1))
    [ "$_down" = 2 ] && event podkop_down "$(jq -nc --arg f "$(failsafe_recent)" \
      '{failsafe: (if $f == "" then null else $f end)}')"
    [ "$_down" -ge 2 ] && recover
  done
}

# --- commands ---------------------------------------------------------------------

cmd_status() {
  _fp=$(config_fp)
  _st=$(podkop_start_state)
  _feat=$(sing-box version 2>/dev/null | sed -n 's/^Features:[[:space:]]*//p')
  _probe=$(cat "$RUN/probe/state" 2>/dev/null || echo none)
  _pins='[]'
  [ -s "$ETC/pins" ] && _pins=$(while IFS="$TAB" read -r _s _h; do
            jq -nc --arg s "$_s" --arg t "$(link_tag "$_s" "$_h")" '{section: $s, server: $t}'
          done < "$ETC/pins" | jq -sc '.')
  reply "$(jq -nc --arg av "$AGENT_VERSION" --argjson pv "$PROTO" --arg boot "$BOOT" \
    --arg up "$(cut -d ' ' -f 1 /proc/uptime | cut -d . -f 1)" \
    --arg model "$(cat /tmp/sysinfo/model 2>/dev/null)" \
    --arg os "$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null)" \
    --arg pk "$(podkop show_version 2>/dev/null)" \
    --arg en "$(podkop_enabled && echo 1 || echo 0)" --arg pa "$([ -f "$ETC/paused" ] && echo 1 || echo 0)" \
    --arg st "$_st" --arg pid "$(singbox_pid)" \
    --arg sb "$(sing-box version 2>/dev/null | awk 'NR == 1 { print $3 }')" --arg feat "$_feat" \
    --arg fp "$_fp" --arg lg "$(cat "$ETC/last-good.fp" 2>/dev/null)" \
    --arg busy "$(flock -n "$RUN/apply.lock" true 2>/dev/null && echo 0 || echo 1)" \
    --arg probe "$_probe" --argjson pins "${_pins:-[]}" \
    --arg fs "$(tail -n 1 /etc/sing-box/failsafe.last 2>/dev/null)" --arg fst "$(head -n 1 /etc/sing-box/failsafe.last 2>/dev/null)" \
    --arg pb "$([ -x "$PROBE" ] && sed -n 's/^VERSION="\(.*\)"/\1/p' "$PROBE")" \
    --arg pcron "$(probe_cron)" --arg tz "$(date +%z)" --arg eng "$(sing-box version 2>/dev/null | grep -q 'tools.decode-link' && echo 1)" \
    '{agent: {version: $av, protocol: $pv}, boot: $boot, uptime: ($up | tonumber? // 0),
      router: {model: $model, openwrt: $os, utc_offset: $tz},
      podkop: {version: $pk, enabled: ($en == "1"), paused: ($pa == "1"), start: $st,
               running: ($pid != ""), busy: ($busy == "1")},
      singbox: {version: $sb, features: ($feat | split(",") | map(select(. != "")))},
      fingerprint: $fp, last_good: $lg, pins: $pins, probe: {state: $probe, version: $pb, cron: $pcron},
      engine: ($eng == "1"),
      failsafe: (if $fs == "" then null else {time: $fst, message: $fs} end)}')"
}

cmd_config_get() {
  _c=$(config_json) || fail podkop "cannot read podkop's settings"
  _svc=$(community_lists)
  _ifs=$(ubus call network.interface dump 2>/dev/null | jq -c '[.interface[]?.interface]')
  _devs=$(ubus call network.device status 2>/dev/null | jq -c 'keys')
  reply "$(printf '%s' "$_c" | jq -c --arg fp "$(printf '%s' "$_c" | fingerprint)" --arg svc "$_svc" \
    --argjson ifs "${_ifs:-[]}" --argjson devs "${_devs:-[]}" \
    '{fingerprint: $fp, config: ., community_lists: ($svc | split(" ") | map(select(. != ""))),
      interfaces: $ifs, devices: $devs}')"
}

cmd_apply() {
  _id=$(job_new apply)
  cat > "$RUN/jobs/$_id.in"
  jq -e '.config.sections | type == "array"' "$RUN/jobs/$_id.in" >/dev/null 2>&1 || {
    job_end "$_id" rejected "expected {\"base\": ..., \"config\": {\"sections\": [...]}}"
    fail bad_request "expected {\"base\": ..., \"config\": {\"sections\": [...]}}"
  }
  spawn _run-apply "$_id"
  reply "$(jq -nc --arg id "$_id" '{job: $id}')"
}

# job <id> [wait seconds]
cmd_job() {
  case "${1:-}" in ""|*[!0-9-]*) fail bad_request "job id expected" ;; esac
  _jf=$(job_file "$1"); [ -f "$_jf" ] || fail not_found "no job $1"
  _w=0; _max=${2:-0}
  case "$_max" in *[!0-9]*) _max=0 ;; esac
  while [ "$_w" -lt "$_max" ]; do
    case "$(jq -r .state "$_jf")" in queued|checking|restarting|reverting|running) ;; *) break ;; esac
    sleep 1; _w=$((_w + 1))
  done
  reply "$(cat "$_jf")"
}

# validate: the checks of "apply" without changing anything
cmd_validate() {
  _vf="$RUN/validate.$$.json"
  cat | jq -c ".config | $NORM" > "$_vf" 2>/dev/null || { rm -f "$_vf"; fail bad_request "expected {\"config\": {...}}"; }
  _bad=$(check_names "$_vf")
  [ -z "$_bad" ] || { rm -f "$_vf"; fail bad_request "\"$_bad\" is not a valid name"; }
  _p=$(validate "$_vf"); rm -f "$_vf"
  reply "$(jq -nc --argjson p "$_p" '{problems: $p}')"
}

# pin <section> <tag|auto>
cmd_pin() {
  _s=${1:-}; _t=${2:-}
  case "$_s" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _pt=$(config_json | jq -r --arg s "$_s" '.sections[] | select(.name == $s) | .options.proxy_config_type // ""')
  case "$_pt" in selector|urltest) ;; *) fail bad_request "section $_s has no server choice (needs selector or urltest)" ;; esac
  exec 6> "$RUN/pins.lock"; flock 6
  touch "$ETC/pins"
  grep -v "^$_s$TAB" "$ETC/pins" > "$RUN/pins.t"
  cmp -s "$RUN/pins.t" "$ETC/pins" || { cp "$RUN/pins.t" "$ETC/pins.t" && mv "$ETC/pins.t" "$ETC/pins"; }
  rm -f "$RUN/pins.t"
  if [ "$_t" = auto ]; then
    [ "$_pt" = urltest ] && { select_server "$_s" "$_s-urltest-out" || fail clash "could not switch $_s-out"; }
    event pin_cleared "$(jq -nc --arg s "$_s" '{section: $s}')"
    reply "$(jq -nc --arg s "$_s" '{section: $s, server: "auto"}')"
  fi
  case "$_t" in ""|*[!A-Za-z0-9_-]*) fail bad_request "server tag expected, like $_s-2-out, or auto" ;; esac
  _l=$(tag_link "$_s" "$_t"); [ -n "$_l" ] || fail not_found "section $_s has no server $_t"
  select_server "$_s" "$_t" || fail clash "could not switch $_s-out to $_t (is podkop running?)"
  printf '%s\t%s\n' "$_s" "$(link_md5 "$_l")" >> "$ETC/pins"
  event pinned "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
  reply "$(jq -nc --arg s "$_s" --arg t "$_t" '{section: $s, server: $t}')"
}

# proxies: groups with their choice and members, and the last delay of every server
cmd_proxies() {
  _p=$(proxies); [ -n "$_p" ] || fail podkop_down "the Clash API does not answer (is podkop running?)"
  reply "$(printf '%s' "$_p" | jq -c '.proxies | {
      groups: [to_entries[] | select(.value.all != null and .key != "GLOBAL")
               | {name: .key, type: .value.type, now: .value.now, all: .value.all}],
      servers: [to_entries[] | select(.value.all == null)
                | {name: .key, type: .value.type, delay: ((.value.history // []) | last | .delay // null)}]}')"
}

# exit-ip <section>: where the section's traffic leaves to the internet now:
# through the server it uses (a sing-box run of just that outbound, taken
# from podkop's running config) or, for a VPN section, its interface ->
# {section, server, ip, country, city, org}
cmd_exit_ip() {
  _s=${1:-}
  case "$_s" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _o=$(config_json | jq -c --arg s "$_s" '.sections[] | select(.name == $s) | .options')
  [ -n "$_o" ] || fail not_found "no section $_s"
  _t=""
  case "$(printf '%s' "$_o" | jq -r '.connection_type // ""')" in
    proxy)
      _p=$(proxies); [ -n "$_p" ] || fail podkop_down "the Clash API does not answer (is podkop running?)"
      # the group's choice; through the urltest group, that group's choice
      _t=$(printf '%s' "$_p" | jq -r --arg s "$_s" '.proxies as $p | ($p["\($s)-out"].now // "\($s)-out") as $n
        | if $n == "\($s)-urltest-out" then ($p[$n].now // "") else $n end')
      case "$_t" in ""|*[!A-Za-z0-9_-]*) fail not_found "section $_s has no server now" ;; esac
      _cfg=$(uci -q get podkop.settings.config_path); [ -n "$_cfg" ] || _cfg=/etc/sing-box/config.json
      # the outbound and the ones it goes through (detour); podkop's DNS servers are not there
      jq -c --arg t "$_t" '.outbounds as $all
        | [$t | recurse(. as $x | ($all[] | select(.tag == $x) | .detour) // empty)] as $chain
        | {log: {disabled: true}, dns: {servers: [{type: "local", tag: "local"}]},
           outbounds: [$all[] | select(.tag as $x | $chain | index($x)) | del(.domain_resolver)],
           route: {final: $t, default_domain_resolver: "local"}}
        | if (.outbounds | length) == 0 then error("no outbound") else . end' "$_cfg" > "$RUN/exit.$$.json" 2>/dev/null ||
        { rm -f "$RUN/exit.$$.json"; fail not_found "$_t is not in sing-box's config"; }
      sing-box tools fetch -c "$RUN/exit.$$.json" https://ipinfo.io/json > "$RUN/exit.$$.out" 2>&1 &
      _fp=$!; _w=0
      while kill -0 "$_fp" 2>/dev/null && [ "$_w" -lt 15 ]; do sleep 1; _w=$((_w + 1)); done
      kill "$_fp" 2>/dev/null; wait "$_fp" 2>/dev/null
      _j=$(cat "$RUN/exit.$$.out"); rm -f "$RUN/exit.$$.json" "$RUN/exit.$$.out" ;;
    vpn)
      _if=$(printf '%s' "$_o" | jq -r '.interface // ""')
      case "$_if" in ""|*[!A-Za-z0-9_.@-]*) fail bad_request "section $_s has no interface" ;; esac
      _t=$_if
      _j=$(curl -s --max-time 15 --interface "$_if" https://ipinfo.io/json 2>/dev/null) ;;
    *) fail bad_request "section $_s does not leave through a server or an interface" ;;
  esac
  printf '%s' "$_j" | jq -e '.ip' >/dev/null 2>&1 ||
    fail exit_unknown "no answer from ipinfo.io through $_t: $(printf '%s' "$_j" | tail -n 1 | tr -d '\033' | sed 's/\[[0-9;]*m//g' | cut -c 1-200)"
  reply "$(printf '%s' "$_j" | jq -c --arg s "$_s" --arg t "$_t" \
    '{section: $s, server: $t, ip: (.ip // ""), country: (.country // ""), city: (.city // ""), org: (.org // "")}')"
}

# delays <section>: test every server of the section now
cmd_delays() {
  case "${1:-}" in ""|*[!A-Za-z0-9_]*) fail bad_request "section name expected" ;; esac
  _d=$(podkop clash_api get_group_latency "$1-out" 10000 2>/dev/null)
  [ -n "$_d" ] || fail podkop_down "the Clash API does not answer"
  reply "$(printf '%s' "$_d" | jq -c '.')"
}

# logs [lines]: podkop, sing-box, podkop-engine and podkop-agent lines
cmd_logs() {
  _n=${1:-200}; case "$_n" in ""|*[!0-9]*) _n=200 ;; esac
  reply "$(logread 2>/dev/null | grep 'podkop\|sing-box' | tail -n "$_n" | jq -Rsc 'split("\n") | map(select(. != ""))')"
}

# watch [since]: events after <since> ("<boot>:<n>"), then new events and log
# lines as they come, one JSON object per line, until stdin closes
cmd_watch() {
  _since=${1:-}; _from=0
  case "$_since" in "$BOOT":*) _from=${_since#*:} ;; esac
  case "$_from" in ""|*[!0-9]*) _from=0 ;; esac
  printf '{"type":"hello","boot":"%s","agent":"%s"}\n' "$BOOT" "$AGENT_VERSION"
  (
    _n=$_from
    while :; do
      if [ -f "$EVENTS" ]; then
        _o=$(awk -v n="$_n" '{ s = $0; sub(/^\{"id":"[^:]*:/, "", s); sub(/".*/, "", s) } s + 0 > n' "$EVENTS")
        if [ -n "$_o" ]; then
          printf '%s\n' "$_o"
          _n=$(printf '%s\n' "$_o" | tail -n 1 | sed 's/^{"id":"[^:]*:\([0-9]*\)".*/\1/')
        fi
      fi
      sleep 1
    done
  ) &
  _p1=$!
  # logread -f does not end when its reader goes away, so remember its pid
  ( logread -f -e 'podkop\|sing-box' 2>/dev/null & echo $! > "$RUN/watch.$$"; wait ) |
    jq -Rc --unbuffered '{type: "log", line: .}' &
  _p2=$!
  cat > /dev/null
  kill "$(cat "$RUN/watch.$$" 2>/dev/null)" "$_p1" "$_p2" 2>/dev/null
  rm -f "$RUN/watch.$$"
  exit 0
}

# service <start|stop|restart|enable|disable>; stop pauses the watchdog too
cmd_service() {
  # not in the middle of an apply or a recovery: its health check would fail
  exec 9> "$RUN/apply.lock"
  flock -n 9 || fail busy "podkop's settings are being applied or podkop is being recovered; try again in a minute"
  case "${1:-}" in
    start)   rm -f "$ETC/paused"; /etc/init.d/podkop start >/dev/null 2>&1 9>&- ;;
    stop)    touch "$ETC/paused"; /etc/init.d/podkop stop >/dev/null 2>&1 9>&- ;;
    restart) rm -f "$ETC/paused"; restart_podkop "restart by manager" ;;
    enable)  /etc/init.d/podkop enable ;;
    disable) /etc/init.d/podkop disable ;;
    *) fail bad_request "start, stop, restart, enable or disable" ;;
  esac
  event service "$(jq -nc --arg a "$1" '{action: $a}')"
  reply "$(jq -nc --arg a "$1" '{action: $a}')"
}

# --- podkop-probe -----------------------------------------------------------------

# options passed through to podkop-probe, with the number of values each takes
PROBE_OPTS="-q:0 -F:0 -v:0 --no-speed:0 --no-youtube:0 --no-entry-check:0 --fix-fingerprint:0 -n:1 -c:1 -j:1 -t:1
--countries:1 --top:1 --max-ping:1 --min-speed:1 --speed-jobs:1 --youtube-noads:1"

# probe_check: a "running" probe whose runner is gone (killed, e.g. out of
# memory, or never started) has failed; call it holding the probe lock (fd 7)
probe_check() {
  [ "$(cat "$RUN/probe/state" 2>/dev/null)" = running ] || return 0
  _pp=$(cat "$RUN/probe/pid" 2>/dev/null)
  if [ -z "$_pp" ]; then
    # the runner writes its pid at once; a minute without it: it never started
    [ -n "$(find "$RUN/probe/started" -mmin -1 2>/dev/null)" ] && return 0
    _why="podkop-agent: the probe did not start (out of memory?)"
  else
    tr '\0' ' ' < "/proc/$_pp/cmdline" 2>/dev/null | grep -q _run-probe && return 0
    _why="podkop-agent: the probe was killed (out of memory?)"
  fi
  echo "$_why" >> "$RUN/probe/log"
  probe_leftovers
  now > "$RUN/probe/finished"
  echo failed > "$RUN/probe/state"
}

# probe_leftovers: a probe killed outright (no time to clean up) leaves its
# sing-box and its /tmp/podkop-probe.<pid> folder; remove those of probes
# that no longer run
probe_leftovers() {
  for _w in /tmp/podkop-probe.[0-9]*; do
    [ -d "$_w" ] || continue
    [ -d "/proc/${_w##*.}" ] && continue
    for _f in "$_w"/pids/*; do
      [ -f "$_f" ] || continue
      _sp=$(cat "$_f"); tr '\0' ' ' < "/proc/$_sp/cmdline" 2>/dev/null | grep -q "$_w/" && kill "$_sp" 2>/dev/null
    done
    rm -rf "$_w"
  done
}

# key_ok <url>: a subscription key is an http(s) address and nothing else
key_ok() { printf '%s' "$1" | grep -qE '^https?://[^[:space:]]+$'; }

# probe-start: stdin {"keys": [subscription urls], "options": ["--countries", "europe", ...]}
cmd_probe_start() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  mkdir -p "$RUN/probe"
  exec 7> "$RUN/probe.lock"; flock 7
  probe_check
  [ "$(cat "$RUN/probe/state" 2>/dev/null)" = running ] && fail busy "a probe is already running"
  # checked before it replaces the last run's request
  _rq="$RUN/probe/req.$$.json"
  cat > "$_rq"
  jq -e '(.keys | type == "array" and length > 0 and all(type == "string"))
         and ((.options // []) | type == "array" and all(type == "string"))' \
    "$_rq" >/dev/null 2>&1 || { rm -f "$_rq"; fail bad_request "expected {\"keys\": [...], \"options\": [...]}"; }
  _left=0
  set -f
  for _k in $(jq -r '.keys[]' "$_rq"); do key_ok "$_k" || { rm -f "$_rq"; fail bad_request "a key is not an http(s) address"; }; done
  for _a in $(jq -r '.options // [] | .[]' "$_rq"); do
    if [ "$_left" -gt 0 ]; then _left=$((_left - 1)); continue; fi
    _k=""
    for _po in $PROBE_OPTS; do [ "${_po%:*}" = "$_a" ] && _k=${_po##*:}; done
    [ -n "$_k" ] || { rm -f "$_rq"; fail bad_request "probe option $_a is not allowed"; }
    _left=$_k
  done
  set +f
  mv "$_rq" "$RUN/probe/req.json"
  echo running > "$RUN/probe/state"
  rm -f "$RUN/probe/result.csv" "$RUN/probe/result.csv.links" "$RUN/probe/exit" "$RUN/probe/pid"
  now > "$RUN/probe/started"
  exec 7>&-   # the runner must not inherit the lock
  if ! spawn _run-probe; then
    echo failed > "$RUN/probe/state"; now > "$RUN/probe/finished"
    fail no_memory "the probe could not be started (out of memory?)"
  fi
  event probe_started
  reply '{"state":"running"}'
}

run_probe() {
  echo $$ > "$RUN/probe/pid"
  set -f
  set --
  for _o in $(jq -r '.options // [] | .[]' "$RUN/probe/req.json"); do set -- "$@" "$_o"; done
  for _k in $(jq -r '.keys[]' "$RUN/probe/req.json"); do set -- "$@" -s "$_k"; done
  rm -f /tmp/podkop-probe-best.txt /tmp/podkop-probe-fallback.txt /tmp/podkop-probe-youtube.txt \
    /tmp/podkop-probe-youtube-fallback.txt
  # at most 3 hours (the manager waits that long); TERM lets it clean up
  if command -v timeout >/dev/null 2>&1; then
    timeout -s TERM 10800 "$PROBE" --no-apply --no-color -o "$RUN/probe/result.csv" "$@" > "$RUN/probe/log" 2>&1
  else
    "$PROBE" --no-apply --no-color -o "$RUN/probe/result.csv" "$@" > "$RUN/probe/log" 2>&1
  fi
  _rc=$?
  probe_leftovers
  (
    flock 7
    echo "$_rc" > "$RUN/probe/exit"
    now > "$RUN/probe/finished"
    if [ "$_rc" = 0 ]; then echo "done" > "$RUN/probe/state"; else echo failed > "$RUN/probe/state"; fi
  ) 7> "$RUN/probe.lock"
  event probe_done "$(jq -nc --argjson rc "$_rc" '{exit: $rc}')"
}

# sub-info: each key's usage header and links, fetched by podkop-probe the
# way the probe does it, so the provider sees the same device
cmd_sub_info() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  _req=$(cat)
  printf '%s' "$_req" | jq -e '.keys | type == "array" and length > 0' >/dev/null 2>&1 || fail bad_request 'expected {"keys": [...]}'
  set -f; set --
  for _k in $(printf '%s' "$_req" | jq -r '.keys[] | strings'); do
    key_ok "$_k" || fail bad_request "a key is not an http(s) address"
    set -- "$@" -s "$_k"
  done
  set +f
  _out=$("$PROBE" --sub-info --no-color "$@" 2>/dev/null)
  printf '%s\n' "$_out" | grep -q '^K' || fail old_probe "podkop-probe can't read key usage: reinstall the agent"
  reply "$(printf '%s\n' "$_out" | jq -Rsc '
    split("\n") | map(select(. != "") | split("\t"))
    | reduce .[] as $r ([]; if $r[0] == "K" then . + [{url: $r[1], usage: ($r[2] // ""), title: ($r[3] // ""), why: ($r[4] // ""), links: []}]
                         elif $r[0] == "L" and length > 0 then .[-1].links += [$r[1:] | join("\t")] else . end)')"
}

# probe-nodes: stdin {"keys": [...], "fix_fingerprint": bool}: every server of
# the keys as {link, outbound} (or {link, why} when podkop can't use it), made
# by podkop-probe with podkop's own parser, for the manager to test them on
# its server through this router
cmd_probe_nodes() {
  [ -x "$PROBE" ] || fail no_probe "podkop-probe is not installed"
  _req=$(cat)
  printf '%s' "$_req" | jq -e '.keys | type == "array" and length > 0' >/dev/null 2>&1 || fail bad_request 'expected {"keys": [...]}'
  set -f; set --
  printf '%s' "$_req" | jq -e '.fix_fingerprint == true' >/dev/null 2>&1 && set -- --fix-fingerprint
  for _k in $(printf '%s' "$_req" | jq -r '.keys[] | strings'); do
    key_ok "$_k" || fail bad_request "a key is not an http(s) address"
    set -- "$@" -s "$_k"
  done
  set +f
  _o="$RUN/nodes.$$"
  "$PROBE" --build-nodes --no-color "$@" > "$_o" 2> "$_o.err"; _rc=$?
  if [ "$_rc" != 0 ]; then
    _why=$(grep -v '^[[:space:]]*$' "$_o.err" | tail -n 2 | tr '\n' ' '); rm -f "$_o" "$_o.err"
    case "$_why" in *"unknown option: --build-nodes"*) fail old_probe "podkop-probe can't build nodes: reinstall the agent" ;; esac
    fail probe "${_why:-podkop-probe failed}"
  fi
  # (OpenWrt's jq has no regular expressions)
  _r=$(jq -Rsc 'split("\n") | map(split("\t") | select(length > 1 and (.[0] | contains("://")) and (.[0] | contains(" ") | not))
    | {link: .[0], ob: (.[1:] | join("\t"))}
    | if (.ob | startswith("!")) then {link, why: .ob[1:]} else {link, outbound: (.ob | fromjson)} end)' "$_o")
  rm -f "$_o" "$_o.err"
  reply "${_r:-[]}"
}

# traffic: bytes per server since the agent started (see traffic_poll)
cmd_traffic() {
  reply "$(jq -c '{since, servers, links: (.links // {})}' "$RUN/traffic/state.json" 2>/dev/null || echo '{"since":"","servers":{},"links":{}}')"
}

lines_json() { if [ -f "$1" ]; then jq -Rsc 'split("\n") | map(select(. != ""))' "$1"; else echo '[]'; fi; }

# the CSV of podkop-probe -o: n,verdict,ok,total,min,median,p90,mbit_s,exit_ip,country,youtube,youtube_ms,"node"
CSV_JQ='split("\n") | .[1:] | map(select(. != "") | split(",") as $f
  | {n: $f[0], verdict: $f[1], ok: $f[2], total: $f[3], min: $f[4], median: $f[5], p90: $f[6],
     mbit: $f[7], exit_ip: $f[8], country: $f[9], youtube: $f[10], youtube_ms: $f[11],
     node: ($f[12:] | join(",") | ltrimstr("\"") | rtrimstr("\"") | split("\"\"") | join("\""))})'

# probe-config: what podkop-probe set up on the router by itself (its keys and
# settings for the nightly run, and its cron line), for the manager to take over
probe_cron() { grep -s 'podkop-probe --cron' /etc/crontabs/root | grep -v '^[[:space:]]*#' | head -n 1; }
cmd_probe_config() {
  [ -f "$PROBE_CONF" ] || reply "$(jq -nc --arg c "$(probe_cron)" '{saved: false, cron: $c}')"
  # its own file, written by podkop-probe as shell assignments
  # shellcheck disable=SC1090
  reply "$( (SUBS=""; COUNTRIES=""; TOP=""; SECTION=""; YOUTUBE=""; YT_NOADS="RU"; YT_SECTION=""; APPLY_TO=""; MAX_PING=""; MIN_SPEED=""
    . "$PROBE_CONF" >/dev/null 2>&1
    jq -nc --arg subs "$SUBS" --arg c "$COUNTRIES" --arg top "$TOP" --arg sec "$SECTION" --arg yt "$YOUTUBE" \
      --arg noads "$YT_NOADS" --arg ysec "$YT_SECTION" --arg to "$APPLY_TO" --arg mp "$MAX_PING" --arg ms "$MIN_SPEED" \
      --arg cron "$(probe_cron)" \
      '{saved: true, keys: ($subs | split("\n") | map(select(. != ""))), countries: $c, top: ($top | tonumber? // 10),
        section: (if $sec == "" then "main" else $sec end), youtube: ($yt != "0"),
        youtube_noads: $noads,
        youtube_section: (if $ysec == "" then "youtube" else $ysec end),
        apply_to: (if $to == "" then "both" else $to end),
        max_ping: ($mp | tonumber? // 700), min_speed: ($ms | tonumber? // 40), cron: $cron}') )"
}

# probe-cron off: the manager runs the nightly probe from now on
cmd_probe_cron() {
  [ "${1:-}" = off ] || fail bad_request "usage: probe-cron off"
  if [ -n "$(probe_cron)" ]; then
    sed -i '/podkop-probe --cron/d' /etc/crontabs/root && /etc/init.d/cron restart >/dev/null 2>&1
    event probe_cron_off '{}'
  fi
  reply '{"cron": ""}'
}

cmd_probe_status() {
  exec 7> "$RUN/probe.lock"; flock 7; probe_check; exec 7>&-
  _log=$(tail -n 400 "$RUN/probe/log" 2>/dev/null | jq -Rsc 'split("\n") | map(select(. != ""))')
  _rows='[]'; [ -s "$RUN/probe/result.csv" ] && _rows=$(jq -Rsc "$CSV_JQ" "$RUN/probe/result.csv")
  # the link of each row, from podkop-probe's result.csv.links ("n<TAB>link")
  if [ -s "$RUN/probe/result.csv.links" ]; then
    _rows=$(jq -Rsc --argjson rows "$_rows" '
      (split("\n") | map(select(. != "") | split("\t") | {key: .[0], value: (.[1:] | join("\t"))}) | from_entries) as $l
      | $rows | map(. + {link: ($l[.n] // null)})' "$RUN/probe/result.csv.links")
  fi
  reply "$(jq -nc --arg st "$(cat "$RUN/probe/state" 2>/dev/null || echo none)" \
    --arg s "$(cat "$RUN/probe/started" 2>/dev/null)" --arg f "$(cat "$RUN/probe/finished" 2>/dev/null)" \
    --arg rc "$(cat "$RUN/probe/exit" 2>/dev/null)" --argjson log "${_log:-[]}" --argjson rows "$_rows" \
    --argjson main "$(lines_json /tmp/podkop-probe-best.txt)" \
    --argjson mainfb "$(lines_json /tmp/podkop-probe-fallback.txt)" \
    --argjson yt "$(lines_json /tmp/podkop-probe-youtube.txt)" \
    --argjson ytfb "$(lines_json /tmp/podkop-probe-youtube-fallback.txt)" \
    '{state: $st, started: $s, finished: $f, exit: ($rc | tonumber? // null), log: $log, rows: $rows,
      lists: {main: $main, main_fallback: $mainfb, youtube: $yt, youtube_fallback: $ytfb}}')"
}

# --- dispatch -----------------------------------------------------------------------

mkdir -p "$RUN/jobs" "$ETC" 2>/dev/null
# over SSH the command comes in SSH_ORIGINAL_COMMAND (forced command of the
# manager's key); the internal commands below are for procd and our own jobs
REMOTE=0
if [ -n "${SSH_CONNECTION:-}" ]; then
  REMOTE=1
  if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    set -f
    # shellcheck disable=SC2086
    set -- $SSH_ORIGINAL_COMMAND
    set +f
    case "${1:-}" in podkop-agent|/usr/bin/podkop-agent) shift ;; esac
  fi
fi

_cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$_cmd" in
  status)        cmd_status ;;
  config-get)    cmd_config_get ;;
  validate)      cmd_validate ;;
  apply)         cmd_apply ;;
  job)           cmd_job "$@" ;;
  pin)           cmd_pin "$@" ;;
  proxies)       cmd_proxies ;;
  delays)        cmd_delays "$@" ;;
  exit-ip)       cmd_exit_ip "$@" ;;
  logs)          cmd_logs "$@" ;;
  watch)         cmd_watch "$@" ;;
  service)       cmd_service "$@" ;;
  probe-start)   cmd_probe_start ;;
  probe-status)  cmd_probe_status ;;
  probe-config)  cmd_probe_config ;;
  probe-cron)    cmd_probe_cron "$@" ;;
  sub-info)      cmd_sub_info ;;
  probe-nodes)   cmd_probe_nodes ;;
  traffic)       cmd_traffic ;;
  uninstall)
    [ -f /usr/share/podkop-agent/install.sh ] || fail not_found "install.sh is not on the router"
    env -u SSH_ORIGINAL_COMMAND -u SSH_CONNECTION -u SSH_CLIENT \
      setsid sh -c 'sleep 2; sh /usr/share/podkop-agent/install.sh --uninstall' </dev/null >/dev/null 2>&1 &
    reply '{"uninstalling":true}' ;;
  version)       reply "$(jq -nc --arg v "$AGENT_VERSION" --argjson p "$PROTO" '{version: $v, protocol: $p}')" ;;
  daemon|_run-apply|_run-probe)
    [ "$REMOTE" = 0 ] || fail forbidden "$_cmd can't be run over SSH"
    case "$_cmd" in
      daemon) daemon ;;
      _run-apply) run_apply "$1" ;;
      _run-probe) run_probe ;;
    esac ;;
  help|-h|--help)
    echo "podkop-agent $AGENT_VERSION: status config-get validate apply job pin proxies exit-ip delays logs watch service probe-start probe-status probe-config probe-cron sub-info probe-nodes traffic uninstall version" ;;
  *) fail bad_request "unknown command $_cmd" ;;
esac
# end of podkop-agent
