#!/bin/sh /etc/rc.common
# podkop-agent watchdog: keeps podkop running, puts pinned servers back
# shellcheck disable=SC2034

START=99
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/podkop-agent daemon
  procd_set_param respawn 3600 5 0
  procd_set_param stderr 1
  procd_close_instance
}
